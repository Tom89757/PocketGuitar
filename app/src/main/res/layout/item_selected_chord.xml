<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/dark_card"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/selected_chord_image"
            android:padding="4dp"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dark_text_primary"
            android:id="@+id/selected_chord_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageButton
            android:id="@+id/remove_chord_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:layout_marginTop="2dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="移除和弦"
            app:tint="@color/dark_text_secondary"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
