<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.example.pocketguitar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.example.pocketguitar.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:theme="@style/Theme.PocketGuitar"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:name="com.example.pocketguitar.PocketGuitarApplication"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/backup_rules"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name="com.example.pocketguitar.ChordPanelActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.pocketguitar.ChordShowActivity"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name="com.example.pocketguitar.FingerstyleActivity"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name="com.example.pocketguitar.ComposeActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity
            android:name="com.example.pocketguitar.SongListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.example.pocketguitar.AiSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>
    </application>
</manifest>
